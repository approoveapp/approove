generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Código de login por e-mail. Só o hash fica salvo; tentativas erradas são contadas.
model LoginCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Janela fixa por chave (ex.: "login:ip:1.2.3.4"). Compartilhada entre instâncias via banco.
model RateLimit {
  key     String   @id
  count   Int
  resetAt BigInt // epoch ms
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 do token enviado por e-mail
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Core Models ───

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  hasCompletedOnboarding Boolean   @default(false)
  sessionVersion         Int       @default(0) // incrementar invalida todos os JWTs do usuário
  trialClaimedAt         DateTime? // um trial Approove por usuário
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  sentInvites ClientInvite[]
  assignedPosts PostItem[] @relation("PostAssignee")
  postsHandedOff PostItem[] @relation("PostHandedOffBy")
  passwordResetTokens PasswordResetToken[]
  statusEvents  PostStatusEvent[] @relation("StatusEventActorUser")
  importJobs    ImportJob[]
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  subscriptionStatus   String?
  plan                 String    @default("free")
  currentPeriodEnd     DateTime?
  trialUsedAt          DateTime?
  trialEndsAt          DateTime?
  // Respostas do onboarding (dono da organização): quem é, quantos clientes, onde aprova hoje.
  profileRole          String?   // freelancer | agency | in_house
  profileClientRange   String?   // 1-2 | 3-5 | 6-15 | 16+
  profileChannels      String?   // lista separada por vírgula: whatsapp,email,slack,drive,other
  profileAnsweredAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships Membership[]
  clients     Client[]
  reviewers   ClientReviewer[]
  importJobs  ImportJob[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // owner, admin, member
  acceptedAt     DateTime? // null = convite pendente
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  slug           String   @unique
  name           String
  cnpj           String?
  address        String?
  website        String?
  instagram      String?
  facebook       String?
  linkedin       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     CalendarVersion[]
  reviewerLinks ClientReviewerClient[]
  importJobs   ImportJob[]

  @@index([organizationId])
}

model ClientReviewer {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientLinks  ClientReviewerClient[]
  invites      ClientInvite[]
  comments     Comment[]
  pins         AnnotationPin[]
  statusEvents PostStatusEvent[] @relation("StatusEventActorReviewer")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model ClientReviewerClient {
  id         String   @id @default(cuid())
  reviewerId String
  clientId   String
  createdAt  DateTime @default(now())

  reviewer ClientReviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, clientId])
  @@index([clientId])
  @@index([reviewerId])
}

model CalendarVersion {
  id        String   @id @default(cuid())
  clientId  String
  version   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  PostItem[]
  tokens ShareToken[]
  invites ClientInvite[]
  importJobs ImportJob[]

  @@unique([clientId, version])
}

model PostItem {
  id                String   @id @default(cuid())
  calendarVersionId String
  scheduledAt       DateTime
  channel           String
  title             String   @default("")
  copyText          String
  status            String   @default("pending") // pending, approved, adjustments (cliente)
  productionStage   String   @default("draft_copy") // draft_copy, waiting_design, internal_review, ready_for_client
  assigneeId        String?
  assignedAt        DateTime?
  assignedById      String?
  handoffNote       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calendarVersion CalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Cascade)
  comments        Comment[]
  attachments     PostAttachment[]
  statusEvents    PostStatusEvent[]
  assignee        User?           @relation("PostAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedBy      User?           @relation("PostHandedOffBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([calendarVersionId, scheduledAt])
  @@index([assigneeId, productionStage])
}

model PostAttachment {
  id         String   @id @default(cuid())
  postItemId String
  type       String   // "post_feed", "post_stories", "post_linkedin", "reels_cover", "carousel", "other"
  label      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  postItem PostItem            @relation(fields: [postItemId], references: [id], onDelete: Cascade)
  versions AttachmentVersion[]

  @@index([postItemId])
}

model AttachmentVersion {
  id               String   @id @default(cuid())
  postAttachmentId String
  url              String   // capa / slide 1 (retrocompat)
  version          Int      @default(1)
  createdAt        DateTime @default(now())

  postAttachment PostAttachment    @relation(fields: [postAttachmentId], references: [id], onDelete: Cascade)
  slides         AttachmentSlide[]
  pins           AnnotationPin[]

  @@unique([postAttachmentId, version])
  @@index([postAttachmentId])
}

model AttachmentSlide {
  id                  String   @id @default(cuid())
  attachmentVersionId String
  order               Int
  url                 String
  mediaType           String   @default("image") // image, video
  label               String?
  createdAt           DateTime @default(now())

  attachmentVersion AttachmentVersion @relation(fields: [attachmentVersionId], references: [id], onDelete: Cascade)
  pins              AnnotationPin[]

  @@unique([attachmentVersionId, order])
  @@index([attachmentVersionId])
}

model AnnotationPin {
  id                  String   @id @default(cuid())
  attachmentVersionId String
  attachmentSlideId   String?
  xPercent            Float
  yPercent            Float
  text                String
  author              String   // "agency", "client"
  authorName          String?
  reviewerId          String?
  resolved            Boolean  @default(false)
  createdAt           DateTime @default(now())

  attachmentVersion AttachmentVersion @relation(fields: [attachmentVersionId], references: [id], onDelete: Cascade)
  attachmentSlide   AttachmentSlide?  @relation(fields: [attachmentSlideId], references: [id], onDelete: Cascade)
  reviewer          ClientReviewer?   @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([attachmentVersionId])
  @@index([attachmentSlideId])
  @@index([reviewerId])
}

model PostStatusEvent {
  id                   String    @id @default(cuid())
  postItemId           String
  type                 String // submitted_for_review, changes_requested, approved, approval_invalidated
  fromStatus           String?
  toStatus             String?
  actorType            String // agency, client, system
  actorUserId          String?
  actorReviewerId      String?
  actorNameSnapshot    String
  visibility           String    @default("client") // client, agency
  invalidationReason   String? // copy_changed, title_changed, creative_version_added, ...
  copySnapshot         String?
  titleSnapshot        String?
  channelSnapshot      String?
  scheduledAtSnapshot  DateTime?
  creativesSnapshot    String? // JSON documental do pacote aprovado
  createdAt            DateTime  @default(now())

  postItem      PostItem        @relation(fields: [postItemId], references: [id], onDelete: Cascade)
  actorUser     User?           @relation("StatusEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorReviewer ClientReviewer? @relation("StatusEventActorReviewer", fields: [actorReviewerId], references: [id], onDelete: SetNull)

  @@index([postItemId, createdAt])
  @@index([actorUserId])
  @@index([actorReviewerId])
}

model Comment {
  id         String   @id @default(cuid())
  postItemId String
  author     String
  authorName String?
  reviewerId String?
  text       String
  createdAt  DateTime @default(now())

  postItem PostItem        @relation(fields: [postItemId], references: [id], onDelete: Cascade)
  reviewer ClientReviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([postItemId, createdAt])
  @@index([reviewerId])
}

model ShareToken {
  id                String    @id @default(cuid())
  token             String    @unique // gerado por generateShareToken()
  kind              String    @default("agency") // agency, invite
  calendarVersionId String
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  calendarVersion CalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Cascade)
  invite          ClientInvite?

  @@index([token])
}

model ClientInvite {
  id                String    @id @default(cuid())
  reviewerId        String
  calendarVersionId String
  shareTokenId      String    @unique
  role              String    @default("approver") // viewer, reviewer, approver
  status            String    @default("active") // pending, active, revoked
  invitedByUserId   String?
  expiresAt         DateTime?
  lastAccessAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviewer        ClientReviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  calendarVersion CalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Cascade)
  shareToken      ShareToken      @relation(fields: [shareTokenId], references: [id], onDelete: Cascade)
  invitedBy       User?           @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewerId])
  @@index([calendarVersionId])
  @@index([status])
}

// Importação com IA: arquivos → proposta de publicações → revisão → criação dos posts.
// Documentos não são guardados (só nome, tamanho e tipo em filesJson); as mídias vão para
// o storage antes do job e ficam em mediaJson, para virarem material dos posts no commit.
model ImportJob {
  id                String    @id @default(cuid())
  organizationId    String
  clientId          String
  calendarVersionId String
  createdByUserId   String?
  status            String    @default("processing") // processing, review, committing, committed, failed, discarded
  filesJson         String // [{ name, size, kind }]
  mediaJson         String    @default("[]") // [{ name, url, mediaType, mime }]
  resultJson        String? // proposta validada (ImportProposal)
  error             String?
  model             String?
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  postsCreated      Int       @default(0)
  committedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calendarVersion CalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([clientId, status])
  @@index([calendarVersionId])
  @@index([createdByUserId])
}
