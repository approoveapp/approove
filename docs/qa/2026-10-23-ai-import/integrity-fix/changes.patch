@@ -0,0 +1,106 @@
+import type { PreparedImportFile } from "./files";
+import { IMPORT_CHANNELS, type ImportProposal } from "./proposal";
+
+type SourceRow = { id: string; file: string; sheet: string; row: number; channel: string };
+export type TabularIndex = { rows: SourceRow[]; unverified: string[]; complete: boolean };
+const normalize = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toLowerCase();
+
+function fields(record: string, delimiter: string) {
+  const result: string[] = [];
+  let value = "", quoted = false;
+  for (let i = 0; i < record.length; i++) {
+    const c = record[i];
+    if (c === '"') {
+      if (quoted && record[i + 1] === '"') { value += '"'; i++; }
+      else quoted = !quoted;
+    } else if (c === delimiter && !quoted) { result.push(value); value = ""; }
+    else value += c;
+  }
+  result.push(value);
+  return result;
+}
+
+/** Labels come from our extractor, not model output. Multiline cells stay in one record. */
+function records(text: string) {
+  const result: { row: number; text: string }[] = [];
+  let quoted = false;
+  for (const line of text.split(/\r?\n/)) {
+    const label = !quoted && line.match(/^\[linha (\d+)\] (.*)$/);
+    if (label) result.push({ row: Number(label[1]), text: label[2] });
+    else if (quoted && result.length) result[result.length - 1].text += `\n${line}`;
+    if ((line.match(/"/g)?.length ?? 0) % 2) quoted = !quoted;
+  }
+  return result;
+}
+
+/** Conservative coverage: only explicit channel + title/copy columns, never generic nonempty-row counts. */
+export function indexTabularSources(files: PreparedImportFile[]): TabularIndex {
+  const index: TabularIndex = { rows: [], unverified: [], complete: files.length > 0 && files.every(file => file.kind === "xlsx" || (file.kind === "text" && /\.(csv|tsv)$/i.test(file.name))) };
+  files.forEach((file, fileIndex) => {
+    if (file.kind !== "xlsx" && !(file.kind === "text" && /\.(csv|tsv)$/i.test(file.name))) return;
+    if (!("text" in file)) return;
+    const sections = file.kind === "xlsx"
+      ? file.text.split(/^## Aba: /m).slice(1).map(section => {
+          const newline = section.indexOf("\n");
+          return { sheet: section.slice(0, newline), text: section.slice(newline + 1) };
+        })
+      : [{ sheet: "", text: file.text }];
+    sections.forEach(({ sheet, text }, sheetIndex) => {
+      const rows = records(text);
+      let channelCol = -1, contentCols: number[] = [], delimiter = ",", header = -1;
+      for (let i = 0; i < Math.min(rows.length, 10); i++) {
+        for (const sep of [",", ";", "\t"]) {
+          const names = fields(rows[i].text, sep).map(normalize);
+          const ch = names.findIndex(n => ["canal", "channel", "rede", "rede social", "plataforma"].includes(n));
+          const contents = names.flatMap((n, j) => ["titulo", "title", "tema", "legenda", "copy", "copytext", "caption"].includes(n) ? [j] : []);
+          if (ch >= 0 && contents.length) { channelCol = ch; contentCols = contents; delimiter = sep; header = i; break; }
+        }
+        if (header >= 0) break;
+      }
+      const location = `${file.name}${sheet ? `, aba ${sheet}` : ""}`;
+      if (header < 0) { index.unverified.push(location); return; }
+      for (const row of rows.slice(header + 1)) {
+        const cells = fields(row.text, delimiter);
+        if (!contentCols.some(col => cells[col]?.trim())) continue;
+        const channel = IMPORT_CHANNELS.find(c => normalize(c) === normalize(cells[channelCol] ?? ""));
+        if (!channel) { index.unverified.push(`${location}, linha ${row.row}`); continue; }
+        index.rows.push({ id: `T${fileIndex + 1}A${sheetIndex + 1}L${row.row}`, file: file.name, sheet, row: row.row, channel });
+      }
+    });
+  });
+  index.complete = index.complete && index.rows.length > 0 && index.unverified.length === 0;
+  return index;
+}
+
+export function tabularSourceInstructions(index: TabularIndex) {
+  if (!index.rows.length) return "";
+  return `Conferência de ocorrências da fonte (extraída das tabelas, não é gabarito):\nCada ocorrência abaixo deve gerar seu próprio item, mesmo quando o conteúdo é idêntico. Em source, inclua exatamente o marcador indicado e cite o arquivo/aba/linha. Não combine linhas. Não use um marcador em outro item.\n${index.rows.map(r => `[origem:${r.id}] ${r.file}${r.sheet ? `, aba ${r.sheet}` : ""}, linha ${r.row}, canal ${r.channel}`).join("\n")}`;
+}
+
+/** Reject partial/combined/repeated coverage before a job can reach review or commit. */
+export function tabularIntegrityError(index: TabularIndex, proposal: ImportProposal): string | null {
+  if (!index.rows.length) return null;
+  const seen = new Map<string, number>();
+  const expected = new Map(index.rows.map(row => [row.id, row]));
+  let invalid = 0;
+  for (const post of proposal.posts) {
+    const ids = [...post.source.matchAll(/\[origem:([^\]]+)\]/g)].map(m => m[1]);
+    if (ids.length > 1 || (index.complete && ids.length === 0)) invalid++;
+    for (const id of ids) {
+      const row = expected.get(id);
+      if (!row || row.channel !== post.channel) invalid++;
+      seen.set(id, (seen.get(id) ?? 0) + 1);
+    }
+  }
+  const missing = index.rows.filter(row => !seen.has(row.id));
+  const repeated = index.rows.filter(row => (seen.get(row.id) ?? 0) > 1);
+  if (!missing.length && !repeated.length && !invalid) return null;
+  const locations = missing.slice(0, 5).map(row => `${row.file}${row.sheet ? ` (${row.sheet})` : ""}, linha ${row.row}`).join("; ");
+  return `A resposta da IA não preservou todas as ocorrências identificadas nas tabelas: ${index.rows.length} esperadas, ${missing.length} ausentes, ${repeated.length} repetidas e ${invalid} referências inválidas.${locations ? ` Confira: ${locations}.` : ""} Nenhuma publicação foi criada. Revise os arquivos e tente novamente; uma nova tentativa pode consumir a cota.`;
+}
+
+export function tabularCoverageWarning(index: TabularIndex) {
+  return index.unverified.length
+    ? `A contagem não foi conferida automaticamente em: ${index.unverified.slice(0, 5).join("; ")}${index.unverified.length > 5 ? ` e mais ${index.unverified.length - 5} locais` : ""}. Podem ser abas auxiliares ou tabelas sem cabeçalhos/canais reconhecidos. Compare com a fonte antes de confirmar.`
+    : null;
+}
